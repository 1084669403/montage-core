# montage-core 密钥与本地开关
# 复制为仓库根 .env 后填写；不要 git add .env。
# 只写本仓库会读的键。空值视为未配置。
# 生效入口：python -m montage doctor / run / webui（直接 import 工具看不到本文件）。

# === 主路径：即梦（shot_runner 默认；video_loop=volcengine）===
# 视觉智能 HMAC（当前接线 jimeng_v30）。方舟 Seedance 是另一条鉴权，默认不抢选型。
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
# === 方舟 Seedance / Seedream（video_loop=ark / image_providers=["ark"]；不会抢走 volcengine）===
# huapi_liaozhai 生图已切 ark（Seedream 5.0 lite）：本键从注释态变为必填。
# ARK_API_KEY=
# ARK_API_BASE=https://ark.cn-beijing.volces.com
# SEEDANCE_MODEL=
# --- Seedream 5.0 lite 生图（模型写死 lite 家族，禁止降级）---
# 只允许 doubao-seedream-5-0-260128 / doubao-seedream-5-0-lite-260128 / ep-* 接入点；
# 其他值（4.5/4.0/pro 等）参数校验直接拒发。
# SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-260128
# 记账：¥0.22/张 ÷ 汇率 → USD（SEEDREAM_USD_PER_IMAGE 直接覆盖优先级最高）。
# SEEDREAM_USD_PER_IMAGE=
# SEEDREAM_CNY_PER_USD=7.2
# 首帧/定妆画幅（缺省按 output_profile：douyin_vertical→9:16，否则 16:9）。
# SEEDREAM_ASPECT=

# === 替代闭环：万相图+视频 + DashScope ASR（同一把 key；video_loop=dashscope）===
DASHSCOPE_API_KEY=

# === 配音：无密钥可用 edge_tts；豆包更稳（与 Seed-Audio 不是同一对密钥）===
DOUBAO_SPEECH_API_KEY=
# DOUBAO_SPEECH_VOICE_TYPE=zh_female_wanwanxiaohe_moon_bigtts

# === Agnes 中国站 2.5 Flash（video_loop=agnes；默认 agnes-video-2.5-flash）===
# 官方示例可用 AGNES_API_KEY；国内键名 AGNES_CN_API_KEY 同样认。
# 默认 Base 已是中国站。只有要走国际站时才设 AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=
# AGNES_CN_API_KEY=
# AGNES_BASE_URL=https://api.agnes-ai.cn/v1
# AGNES_API_BASE_URL=
# 回滚 2.0：AGNES_VIDEO_MODEL=agnes-video-v2.0
# 画幅覆写（缺省按 output_profile 推导：*_vertical→9:16、cinematic_21_9→21:9、否则 16:9）。
# 取值须在图片∩视频交集六值：21:9 / 16:9 / 4:3 / 1:1 / 3:4 / 9:16（2:3、3:2 只对图片合法）。
# AGNES_RATIO=
# 访问档位（唯一来源）：default | enterprise | tokenplan。不设即按免费/默认档。
# 注意：.env 不覆盖已存在的 shell 变量；切档前先 unset 同名 shell 变量，否则本行不生效。
# AGNES_ACCESS_TYPE=default
# Token Plan 每日配额记帐文件（缺省 ~/.montage/agnes_usage.json；只告警不阻断）。
# MONTAGE_AGNES_USAGE_PATH=

# === 确定契约、非默认路径 ===
ZHIPU_API_KEY=

# === 待联调：有密钥再取消注释 ===
# KLING_API_KEY=
# KLING_API_SECRET=
# 开放平台新面（无 /v1）。默认 https://api-beijing.klingai.com；与 /v1 资产面同一套 JWT/Bearer。
# KLING_OPEN_BASE=https://api-beijing.klingai.com
# Image Omni：默认 POST {OPEN}/v1/images/omni-image；poll 默认 v1 succeed。
# 静图默认 Kling Image 3.0 Omni（model_name=kling-v3-omni）。可改 kling-image-o1。
# 禁止 kling-v1。本键不要填 API Key；乱填会忽略并回默认。
# KLING_IMAGE_OMNI_PATH=/images/omni-image
# KLING_IMAGE_OMNI_MODEL=kling-v3-omni
# KLING_IMAGE_OMNI_POLL=v1
# 第 6 波联调：导出 KLING_LIVE=1 再跑 tests/test_kling_live.py；拼板+双桥再加 KLING_LIVE_EXPENSIVE=1。无密钥不要开真实请求。
# 装箱：本地图转 base64，默认 10MB；data_uri 才包 data:image/... 前缀。
# KLING_MEDIA_MAX_BYTES=10000000
# KLING_MEDIA_B64_FORMAT=raw
# 视频默认 1080p、静图默认 2k。路由默认 Omni；FORCE 才回旧面。
# KLING_VIDEO_RESOLUTION=1080p
# KLING_IMAGE_RESOLUTION=2k
# estimate_cost = credits × 本值（视频按秒，静图 2k 单独档）。未设时按 0.02（保守，禁止当 0）。
# KLING_USD_PER_CREDIT=0.02
# KLING_OMNI_MODEL 不再作为选车间条件（路径即模型）。FORCE / 关 Omni：
# KLING_FORCE_V1=1
# KLING_FORCE_21=1
# KLING_DISABLE_OMNI=1
# KLING_OMNI_MODEL=
# KLING_I2V_MODEL=
# HUNYUAN_API_KEY=
# DOUBAO_SEED_AUDIO_ACCESSKEY=
# DOUBAO_SEED_AUDIO_SECRETKEY=

# === 素材检索（stock_retriever，非成片主路径）===
# PIXABAY_API_KEY=
# PEXELS_API_KEY=

# === 音频远程检索（asset_retriever 加 remote=true 时；本地配方不需要）===
# JAMENDO_CLIENT_ID=
# FREESOUND_API_KEY=

# === 千问 VL 质检（P3 vlm_reviewer；与 ASR 共用 DASHSCOPE_API_KEY）===
# QWEN_VL_MODEL=qwen-vl-plus
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com
# 真钥烟测：MONTAGE_REAL_VLM=1（不进默认 minitest）

# === 本地开关（不是密钥；联调 FFmpeg 真出片时再开）===
# MONTAGE_REAL_FFMPEG=1
# MONTAGE_BUDGET_SOFT=1
# MONTAGE_RELAX_GATES=1
# 无人值守 produce（CI）：设为 1 时拒绝样品停/未确认 retry/系列非 --review none。不要当默认。
# MONTAGE_HEADLESS=1
